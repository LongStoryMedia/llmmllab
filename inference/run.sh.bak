#!/bin/bash
# run.sh - Script to start and monitor the FastAPI server in containerized environments

# Run with debug capabilities
echo "[STARTUP] Starting run.sh with bash version: $BASH_VERSION"
echo "[STARTUP] Arguments: $@"
echo "[STARTUP] Working directory: $(pwd)"
echo "[STARTUP] Date: $(date)"
echo "[STARTUP] Hostname: $(hostname)"
echo "[STARTUP] User: $(whoami)"

# Remove -e flag as it causes the script to exit on any error
# which can make debugging very difficult in container environments
# set -e

# Important: Always source run_with_env.sh to make the 'v' function available
source ./run_with_env.sh || { echo "Failed to source run_with_env.sh"; exit 1; }

# Color codes for better visibility
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Define service status file globally
SERVICE_STATUS_FILE="/tmp/service_status"

# Function to log messages
log() {
    local level=$1
    local message=$2
    local color=${3:-$BLUE}
    echo -e "${color}[${level}]${NC} ${message}"
}

# Always assume we're in a container - this script is designed to run in Kubernetes/Docker
in_container() {
    # Always return true - this script always runs in container
    log "DEBUG" "Running in container mode" "$BLUE"
    return 0
}

# Function to find PIDs of all related Python processes (both uvicorn and WatchFiles)
find_pids() {
    log "DEBUG" "Looking for Python processes..." "$BLUE"
    
    # Try different methods to find processes and combine results
    local python_pids=""
    
    # Try ps command first
    if command -v ps &> /dev/null; then
        python_pids=$(ps -ef | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
    fi
    
    # Try pgrep as a backup if ps returned nothing
    if [ -z "$python_pids" ] && command -v pgrep &> /dev/null; then
        python_pids=$(pgrep -f "python|uvicorn" 2>/dev/null || echo "")
    fi
    
    # Log all Python processes for debugging
    if [ -n "$python_pids" ]; then
        log "DEBUG" "Found Python processes: $python_pids" "$BLUE"
    else
        log "DEBUG" "No Python processes found" "$YELLOW"
    fi
    
    # Return the list of PIDs
    echo "$python_pids"
}

# Function to find PIDs of all related Python processes (both uvicorn and WatchFiles)
find_pids() {
    log "DEBUG" "Looking for Python processes..." "$BLUE"
    
    if in_container; then
        # In container, find all python processes using multiple approaches for redundancy
        log "DEBUG" "Using container-specific process finding approach" "$BLUE"
        
        # Try ps command first
        local python_pids
        python_pids=""
        
        # Try different methods to find processes and combine results
        if command -v ps &> /dev/null; then
            log "DEBUG" "Using ps to find processes" "$BLUE"
            python_pids=$(ps -ef 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
            
            if [ -z "$python_pids" ]; then
                log "DEBUG" "No processes found with ps, trying alternate ps syntax" "$YELLOW"
                python_pids=$(ps aux 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
            fi
        fi
        
        # Try pgrep as a backup
        if [ -z "$python_pids" ] && command -v pgrep &> /dev/null; then
            log "DEBUG" "Using pgrep to find processes" "$BLUE"
            python_pids=$(pgrep -f "python|uvicorn" 2>/dev/null || echo "")
        fi
        
        # Try /proc as a last resort
        if [ -z "$python_pids" ] && [ -d "/proc" ]; then
            log "DEBUG" "Using /proc to find processes" "$BLUE"
            for pid_dir in /proc/[0-9]*; do
                pid=$(basename "$pid_dir")
                if grep -q "python\|uvicorn" "$pid_dir/cmdline" 2>/dev/null; then
                    python_pids="$python_pids $pid"
                fi
            done
        fi
        
        # Log all Python processes for debugging
        if [ -n "$python_pids" ]; then
            log "DEBUG" "Found Python processes: $python_pids" "$BLUE"
        else
            log "DEBUG" "No Python processes found" "$YELLOW"
        fi
        
        # Return the list of PIDs
        echo "$python_pids"
    else
        # On host machine, use pgrep to find both uvicorn and python processes
        log "DEBUG" "Using host-specific process finding approach" "$BLUE"
        local pids
        pids=""
        
        if command -v pgrep &> /dev/null; then
            pids=$(pgrep -f "python|uvicorn" 2>/dev/null || echo "")
        else
            pids=$(ps -ef 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
        fi
        
        log "DEBUG" "Found Python/uvicorn processes: $pids" "$BLUE"
        echo "$pids"
    fi
}

# Function to display process details
show_process_info() {
    local pid=$1
    
    if [ -z "$pid" ]; then
        return
    fi
    
    if in_container; then
        ps -f -p "$pid" 2>/dev/null || log "DEBUG" "Process $pid no longer exists" "$YELLOW"
    else
        ps -p "$pid" -o pid,ppid,cmd 2>/dev/null || log "DEBUG" "Process $pid no longer exists" "$YELLOW"
    fi
}

# Function to kill processes
kill_processes() {
    local pids=$1
    local signal=$2
    
    for pid in $pids; do
        log "INFO" "Sending $signal to process $pid" "$BLUE"
        show_process_info "$pid"
        kill $signal $pid 2>/dev/null || log "WARNING" "Failed to kill process $pid" "$YELLOW"
    done
}

# Main function
main() {
    log "INFO" "Starting force restart of server processes..." "$BLUE"
    
    # Check environment
    log "DEBUG" "Working directory: $(pwd)" "$BLUE"
    log "DEBUG" "File exists check: /app/server exists: $([ -d "/app/server" ] && echo "yes" || echo "no")" "$BLUE"
    log "DEBUG" "Script location: ${BASH_SOURCE[0]}" "$BLUE"
    log "DEBUG" "User: $(whoami)" "$BLUE"
    log "DEBUG" "Container detection:" "$BLUE"
    if [ -f "/.dockerenv" ]; then
        log "DEBUG" "  - /.dockerenv file exists" "$GREEN"
    else
        log "DEBUG" "  - /.dockerenv file does not exist" "$RED"
    fi
    if [ -f "/proc/1/cgroup" ]; then
        log "DEBUG" "  - cgroup info: $(cat /proc/1/cgroup | grep -E 'docker|lxc|kubepods' || echo 'No container info found')" "$BLUE"
    else
        log "DEBUG" "  - /proc/1/cgroup does not exist" "$RED"
    fi
    
    # Check current process state before doing anything
    log "INFO" "Current process state:" "$GREEN"
    if in_container; then
        ps -ef | grep -E "python|uvicorn" | grep -v grep || log "DEBUG" "No python/uvicorn processes found" "$YELLOW"
    else
        pgrep -af "python|uvicorn" || log "DEBUG" "No python/uvicorn processes found" "$YELLOW"
    fi
    
    # Find all Python processes
    local pids
    pids=$(find_pids)
    
    if [ -z "$pids" ]; then
        log "WARNING" "No Python processes found running" "$YELLOW"
    else
        log "INFO" "Found Python processes: $pids" "$BLUE"
        
        # Try graceful termination first
        log "INFO" "Attempting graceful termination..." "$BLUE"
        kill_processes "$pids" "-TERM"
        
        # Wait a few seconds
        log "INFO" "Waiting for processes to terminate..." "$BLUE"
        sleep 5
        
        # Check if processes still running
        pids=$(find_pids)
        if [ -n "$pids" ]; then
            log "WARNING" "Some processes still running after graceful termination" "$YELLOW"
            log "INFO" "Forcing termination with SIGKILL..." "$BLUE"
            kill_processes "$pids" "-9"
            sleep 3
            
            # Final check for any stragglers
            pids=$(find_pids)
            if [ -n "$pids" ]; then
                log "WARNING" "Some processes are still running after SIGKILL" "$RED"
                log "INFO" "Details of surviving processes:" "$RED"
                for pid in $pids; do
                    show_process_info "$pid"
                done
            fi
        fi
    fi
    
    # Verify all processes are stopped
    pids=$(find_pids)
    if [ -n "$pids" ]; then
        log "ERROR" "Failed to kill all Python processes: $pids" "$RED"
        log "INFO" "You may need to manually kill these processes" "$BLUE"
        
        # In container environment, try to find parent processes
        if in_container; then
            log "INFO" "Checking parent processes..." "$BLUE"
            ps -ef | grep -E "startup.sh|run.sh|bash" | grep -v grep
        fi
        
        return 1
    fi
    
    log "SUCCESS" "All server processes successfully terminated" "$GREEN"
    
    # Find the service status file if it exists
    local service_status_file="/tmp/service_status"
    if [ -f "$service_status_file" ]; then
        log "INFO" "Found service status file: $service_status_file" "$BLUE"
        cat "$service_status_file"
        
        # Remove or reset the service status file
        log "INFO" "Resetting service status file" "$BLUE"
        echo "# Service status file - $(date)" > "$service_status_file"
    fi
    
    # Check if we should restart automatically
    read -p "Do you want to restart the server now? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log "INFO" "Restart canceled. You can restart manually." "$YELLOW"
        return 0
    fi
    
    # Start the server
    log "INFO" "Starting uvicorn server without --reload flag..." "$GREEN"
    
    # In Kubernetes environment, try the command from startup.sh
    if in_container; then
        # First try sourcing the environment if available
        if [ -f "./activate_env.sh" ]; then
            log "INFO" "Activating server environment..." "$GREEN"
            source ./activate_env.sh server
        fi
        
        # Try to start without the --reload flag
        if [ -d "./server" ]; then
            log "INFO" "Starting server directly with uvicorn..." "$GREEN"
            # Start the server in the background
            python -m uvicorn server.app:app --host 0.0.0.0 --port 8000 &
            
            # Save PID
            local new_pid=$!
            log "INFO" "Server started with PID: $new_pid" "$GREEN"
            
            # Update service status file if it exists
            if [ -f "$service_status_file" ]; then
                echo "rest_api:running:$new_pid" >> "$service_status_file"
            fi
            
            # Wait a moment and check if the process is running
            sleep 3
            if kill -0 $new_pid 2>/dev/null; then
                log "SUCCESS" "Server started successfully" "$GREEN"
            else
                log "ERROR" "Server failed to start" "$RED"
            fi
        else
            # Fall back to standard scripts
            if [ -f "./run.sh" ]; then
                log "INFO" "Starting the server using run.sh..." "$GREEN"
                ./run.sh
                elif [ -f "./startup.sh" ]; then
                log "INFO" "Starting the server using startup.sh..." "$GREEN"
                ./startup.sh
            else
                log "ERROR" "Could not find run.sh or startup.sh. Please start the server manually." "$RED"
                return 1
            fi
        fi
    else
        # On host machine, use standard scripts
        if [ -f "./run.sh" ]; then
            log "INFO" "Starting the server using run.sh..." "$GREEN"
            ./run.sh
            elif [ -f "./startup.sh" ]; then
            log "INFO" "Starting the server using startup.sh..." "$GREEN"
            ./startup.sh
        else
            log "ERROR" "Could not find run.sh or startup.sh. Please start the server manually." "$RED"
            return 1
        fi
    fi
    
    log "SUCCESS" "Restart complete" "$GREEN"
}

# Run the main function
main "$@"

# Function to start the FastAPI server
run_server() {
    log "INFO" "Starting FastAPI server..." "${BLUE}"
    
    # This check can be improved to see if the port is already in use
    
    # Determine correct working directory and python module path
    if [ -f "/app/server/main.py" ]; then
        log "INFO" "Found main.py in server directory, using it as entry point" "${BLUE}"
        cd /app || { log "ERROR" "Failed to change directory to /app" "${RED}"; return 1; }
        
        # Use environment variable to control reload behavior
        RELOAD_FLAG=""
        if [ "${RELOAD_ENABLED:-1}" = "1" ]; then
            RELOAD_FLAG="--reload"
        fi
        
        # Run server using main.py (preferred method)
        v "server" python -m server.main --host 0.0.0.0 --port "${PORT:-8000}" $RELOAD_FLAG 2>&1 | tee /var/log/server_api.log &
        SERVER_PID=$!
        
        if [ $? -eq 0 ]; then
            log "INFO" "FastAPI server started on port ${PORT:-8000} with PID $SERVER_PID" "${GREEN}"
            echo "rest_api:running:$SERVER_PID" >> $SERVICE_STATUS_FILE
        else
            log "ERROR" "Failed to start FastAPI server using main.py" "${RED}"
            echo "rest_api:failed:0" >> $SERVICE_STATUS_FILE
        fi
    else
        log "WARNING" "main.py not found, trying to start app.py directly" "${YELLOW}"
        
        # Check if app.py exists in server directory
        if [ -f "/app/server/app.py" ]; then
            cd /app || { log "ERROR" "Failed to change directory to /app" "${RED}"; return 1; }
            
            # Use environment variable to control reload behavior
            RELOAD_FLAG=""
            if [ "${RELOAD_ENABLED:-1}" = "1" ]; then
                RELOAD_FLAG="--reload"
            fi
            
            # Run server using uvicorn directly with server.app:app
            v "server" python -m uvicorn server.app:app --host 0.0.0.0 --port "${PORT:-8000}" $RELOAD_FLAG 2>&1 | tee /var/log/server_api.log &
            SERVER_PID=$!
            
            if [ $? -eq 0 ]; then
                log "INFO" "FastAPI server started on port ${PORT:-8000} with PID $SERVER_PID" "${GREEN}"
                echo "rest_api:running:$SERVER_PID" >> $SERVICE_STATUS_FILE
            else
                log "ERROR" "Failed to start FastAPI server using app.py" "${RED}"
                echo "rest_api:failed:0" >> $SERVICE_STATUS_FILE
            fi
        else
            log "ERROR" "Neither main.py nor app.py found in /app/server directory" "${RED}"
            echo "rest_api:missing:0" >> $SERVICE_STATUS_FILE
            ls -la /app/server
        fi
    fi
}

# Start server if app.py or main.py exists
if [ -f /app/server/app.py ] || [ -f /app/server/main.py ]; then
    run_server
else
    log "WARNING" "Neither app.py nor main.py found in /app/server directory" "${YELLOW}"
    ls -la /app/server
    echo "rest_api:missing:0" >> $SERVICE_STATUS_FILE
fi

# Start gRPC server if grpc_server.py exists
if [ -f /app/server/grpc_server.py ]; then
    log "INFO" "Starting gRPC server..." "${BLUE}"
    # This check can be improved to see if the port is already in use
    v "server" python -m server.grpc_server --port "${GRPC_PORT:-50051}" --max_workers "${GRPC_MAX_WORKERS:-10}" &> /var/log/grpc_server.log &
    GRPC_PID=$!
    if [ $? -eq 0 ]; then
        log "INFO" "gRPC server started on port ${GRPC_PORT:-50051} with PID $GRPC_PID" "${GREEN}"
        echo "grpc_server:running:$GRPC_PID" >> $SERVICE_STATUS_FILE
        # Wait for the gRPC server to become available
        # Note: This wait_for_service uses HTTP check, which will fail for a gRPC service.
        # A proper gRPC health check would be needed for this.
        log "INFO" "Skipping gRPC health check as it requires a gRPC-specific client." "${YELLOW}"
    else
        log "ERROR" "Failed to start gRPC server" "${RED}"
        echo "grpc_server:failed:0" >> $SERVICE_STATUS_FILE
    fi
else
    log "WARNING" "grpc_server.py not found in /app/server directory" "${YELLOW}"
    echo "grpc_server:missing:0" >> $SERVICE_STATUS_FILE
fi

log "INFO" "-----------------------------------------------------------" "${GREEN}"
log "INFO" "All services started. Container is now running." "${GREEN}"
log "INFO" "Service logs are available in /var/log/" "${BLUE}"
log "INFO" "Use 'docker exec' to run commands in this container." "${BLUE}"
log "INFO" "Example: docker exec -it <container_id> /app/run_with_env.sh server python -m your_command" "${BLUE}"
log "INFO" "-----------------------------------------------------------" "${GREEN}"


# Monitor running services
monitor_services() {
    while true; do
        log "INFO" "Checking service status..." "${BLUE}"
        while IFS=: read -r service status pid; do
            if [ "$status" = "running" ] && [ "$pid" -ne "0" ]; then
                if ! ps -p "$pid" &> /dev/null; then
                    log "ERROR" "$service (PID $pid) has died" "${RED}"
                    # Here you could implement restart logic if needed
                    if [ "$pid" -eq "$SERVER_PID" ]; then
                        log "INFO" "Restarting $service..." "${BLUE}"
                        run_server
                    fi
                    if [ "$pid" -eq "$OLLAMA_PID" ]; then
                        log "INFO" "Restarting Ollama service..." "${BLUE}"
                        run_ollama
                    fi
                else
                    log "INFO" "$service (PID $pid) is running" "${GREEN}"
                fi
            fi
        done < "$SERVICE_STATUS_FILE"
        sleep 60  # Check every minute
    done
}

# Start the service monitoring in the background
monitor_services &
MONITOR_PID=$!

# Handle signals gracefully
cleanup() {
    log "INFO" "Shutting down services..." "${YELLOW}"
    # Kill all processes started by this script
    if [ -f "$SERVICE_STATUS_FILE" ]; then
        while IFS=: read -r service status pid; do
            if [ "$status" = "running" ] && [ "$pid" -ne 0 ]; then
                log "INFO" "Stopping $service (PID $pid)..." "${BLUE}"
                kill -TERM "$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
            fi
        done < "$SERVICE_STATUS_FILE"
    fi
    # Kill the monitoring process
    if [ -n "$MONITOR_PID" ]; then
        kill "$MONITOR_PID" 2>/dev/null
    fi
    # Kill any other background jobs of this script
    jobs -p | xargs kill 2>/dev/null
    log "INFO" "All services stopped" "${GREEN}"
    exit 0
}

trap cleanup INT TERM EXIT

# Keep container running
tail -f /dev/null    if hostname | grep -q "[0-9a-f]\{12\}"; then
        log "DEBUG" "Hostname looks like a container ID" "$BLUE"
        return 0
    fi
    
    log "DEBUG" "Not running in a container" "$YELLOW"
    return 1
}

# Function to find PIDs of all related Python processes (both uvicorn and WatchFiles)
find_pids() {
    log "DEBUG" "Looking for Python processes..." "$BLUE"
    
    if in_container; then
        # In container, find all python processes using multiple approaches for redundancy
        log "DEBUG" "Using container-specific process finding approach" "$BLUE"
        
        # Try ps command first
        local python_pids
        python_pids=""
        
        # Try different methods to find processes and combine results
        if command -v ps &> /dev/null; then
            log "DEBUG" "Using ps to find processes" "$BLUE"
            python_pids=$(ps -ef 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
            
            if [ -z "$python_pids" ]; then
                log "DEBUG" "No processes found with ps, trying alternate ps syntax" "$YELLOW"
                python_pids=$(ps aux 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
            fi
        fi
        
        # Try pgrep as a backup
        if [ -z "$python_pids" ] && command -v pgrep &> /dev/null; then
            log "DEBUG" "Using pgrep to find processes" "$BLUE"
            python_pids=$(pgrep -f "python|uvicorn" 2>/dev/null || echo "")
        fi
        
        # Try /proc as a last resort
        if [ -z "$python_pids" ] && [ -d "/proc" ]; then
            log "DEBUG" "Using /proc to find processes" "$BLUE"
            for pid_dir in /proc/[0-9]*; do
                pid=$(basename "$pid_dir")
                if grep -q "python\|uvicorn" "$pid_dir/cmdline" 2>/dev/null; then
                    python_pids="$python_pids $pid"
                fi
            done
        fi
        
        # Log all Python processes for debugging
        if [ -n "$python_pids" ]; then
            log "DEBUG" "Found Python processes: $python_pids" "$BLUE"
        else
            log "DEBUG" "No Python processes found" "$YELLOW"
        fi
        
        # Return the list of PIDs
        echo "$python_pids"
    else
        # On host machine, use pgrep to find both uvicorn and python processes
        log "DEBUG" "Using host-specific process finding approach" "$BLUE"
        local pids
        pids=""
        
        if command -v pgrep &> /dev/null; then
            pids=$(pgrep -f "python|uvicorn" 2>/dev/null || echo "")
        else
            pids=$(ps -ef 2>/dev/null | grep -E "python|uvicorn" | grep -v grep | awk '{print $2}' || echo "")
        fi
        
        log "DEBUG" "Found Python/uvicorn processes: $pids" "$BLUE"
        echo "$pids"
    fi
}

# Function to display process details
show_process_info() {
    local pid=$1
    
    if [ -z "$pid" ]; then
        return
    fi
    
    if in_container; then
        ps -f -p "$pid" 2>/dev/null || log "DEBUG" "Process $pid no longer exists" "$YELLOW"
    else
        ps -p "$pid" -o pid,ppid,cmd 2>/dev/null || log "DEBUG" "Process $pid no longer exists" "$YELLOW"
    fi
}

# Function to kill processes
kill_processes() {
    local pids=$1
    local signal=$2
    
    for pid in $pids; do
        log "INFO" "Sending $signal to process $pid" "$BLUE"
        show_process_info "$pid"
        kill $signal $pid 2>/dev/null || log "WARNING" "Failed to kill process $pid" "$YELLOW"
    done
}

# Main function
main() {
    log "INFO" "Starting force restart of server processes..." "$BLUE"
    
    # Check environment
    log "DEBUG" "Working directory: $(pwd)" "$BLUE"
    log "DEBUG" "File exists check: /app/server exists: $([ -d "/app/server" ] && echo "yes" || echo "no")" "$BLUE" 
    log "DEBUG" "Script location: ${BASH_SOURCE[0]}" "$BLUE"
    log "DEBUG" "User: $(whoami)" "$BLUE"
    log "DEBUG" "Container detection:" "$BLUE"
    if [ -f "/.dockerenv" ]; then
        log "DEBUG" "  - /.dockerenv file exists" "$GREEN"
    else
        log "DEBUG" "  - /.dockerenv file does not exist" "$RED"
    fi
    if [ -f "/proc/1/cgroup" ]; then
        log "DEBUG" "  - cgroup info: $(cat /proc/1/cgroup | grep -E 'docker|lxc|kubepods' || echo 'No container info found')" "$BLUE"
    else
        log "DEBUG" "  - /proc/1/cgroup does not exist" "$RED"
    fi
    
    # Check current process state before doing anything
    log "INFO" "Current process state:" "$GREEN"
    if in_container; then
        ps -ef | grep -E "python|uvicorn" | grep -v grep || log "DEBUG" "No python/uvicorn processes found" "$YELLOW"
    else
        pgrep -af "python|uvicorn" || log "DEBUG" "No python/uvicorn processes found" "$YELLOW"
    fi
    
    # Find all Python processes
    local pids
    pids=$(find_pids)
    
    if [ -z "$pids" ]; then
        log "WARNING" "No Python processes found running" "$YELLOW"
    else
        log "INFO" "Found Python processes: $pids" "$BLUE"
        
        # Try graceful termination first
        log "INFO" "Attempting graceful termination..." "$BLUE"
        kill_processes "$pids" "-TERM"
        
        # Wait a few seconds
        log "INFO" "Waiting for processes to terminate..." "$BLUE"
        sleep 5
        
        # Check if processes still running
        pids=$(find_pids)
        if [ -n "$pids" ]; then
            log "WARNING" "Some processes still running after graceful termination" "$YELLOW"
            log "INFO" "Forcing termination with SIGKILL..." "$BLUE"
            kill_processes "$pids" "-9"
            sleep 3
            
            # Final check for any stragglers
            pids=$(find_pids)
            if [ -n "$pids" ]; then
                log "WARNING" "Some processes are still running after SIGKILL" "$RED"
                log "INFO" "Details of surviving processes:" "$RED"
                for pid in $pids; do
                    show_process_info "$pid"
                done
            fi
        fi
    fi
    
    # Verify all processes are stopped
    pids=$(find_pids)
    if [ -n "$pids" ]; then
        log "ERROR" "Failed to kill all Python processes: $pids" "$RED"
        log "INFO" "You may need to manually kill these processes" "$BLUE"
        
        # In container environment, try to find parent processes
        if in_container; then
            log "INFO" "Checking parent processes..." "$BLUE"
            ps -ef | grep -E "startup.sh|run.sh|bash" | grep -v grep
        fi
        
        return 1
    fi
    
    log "SUCCESS" "All server processes successfully terminated" "$GREEN"
    
    # Find the service status file if it exists
    local service_status_file="/tmp/service_status"
    if [ -f "$service_status_file" ]; then
        log "INFO" "Found service status file: $service_status_file" "$BLUE"
        cat "$service_status_file"
        
        # Remove or reset the service status file
        log "INFO" "Resetting service status file" "$BLUE"
        echo "# Service status file - $(date)" > "$service_status_file"
    fi
    
    # Check if we should restart automatically
    read -p "Do you want to restart the server now? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log "INFO" "Restart canceled. You can restart manually." "$YELLOW"
        return 0
    fi
    
    # Start the server
    log "INFO" "Starting uvicorn server without --reload flag..." "$GREEN"
    
    # In Kubernetes environment, try the command from startup.sh
    if in_container; then
        # First try sourcing the environment if available
        if [ -f "./activate_env.sh" ]; then
            log "INFO" "Activating server environment..." "$GREEN"
            source ./activate_env.sh server
        fi
        
        # Try to start without the --reload flag
        if [ -d "./server" ]; then
            log "INFO" "Starting server directly with uvicorn..." "$GREEN"
            # Start the server in the background
            python -m uvicorn server.app:app --host 0.0.0.0 --port 8000 &
            
            # Save PID
            local new_pid=$!
            log "INFO" "Server started with PID: $new_pid" "$GREEN"
            
            # Update service status file if it exists
            if [ -f "$service_status_file" ]; then
                echo "rest_api:running:$new_pid" >> "$service_status_file"
            fi
            
            # Wait a moment and check if the process is running
            sleep 3
            if kill -0 $new_pid 2>/dev/null; then
                log "SUCCESS" "Server started successfully" "$GREEN"
            else
                log "ERROR" "Server failed to start" "$RED"
            fi
        else
            # Fall back to standard scripts
            if [ -f "./run.sh" ]; then
                log "INFO" "Starting the server using run.sh..." "$GREEN"
                ./run.sh
                elif [ -f "./startup.sh" ]; then
                log "INFO" "Starting the server using startup.sh..." "$GREEN"
                ./startup.sh
            else
                log "ERROR" "Could not find run.sh or startup.sh. Please start the server manually." "$RED"
                return 1
            fi
        fi
    else
        # On host machine, use standard scripts
        if [ -f "./run.sh" ]; then
            log "INFO" "Starting the server using run.sh..." "$GREEN"
            ./run.sh
            elif [ -f "./startup.sh" ]; then
            log "INFO" "Starting the server using startup.sh..." "$GREEN"
            ./startup.sh
        else
            log "ERROR" "Could not find run.sh or startup.sh. Please start the server manually." "$RED"
            return 1
        fi
    fi
    
    log "SUCCESS" "Restart complete" "$GREEN"
}

# Run the main function
main "$@"

# Function to start the FastAPI server
run_server() {
    log "INFO" "Starting FastAPI server..." "${BLUE}"
    
    # This check can be improved to see if the port is already in use
    
    # Determine correct working directory and python module path
    if [ -f "/app/server/main.py" ]; then
        log "INFO" "Found main.py in server directory, using it as entry point" "${BLUE}"
        cd /app || { log "ERROR" "Failed to change directory to /app" "${RED}"; return 1; }
        
        # Use environment variable to control reload behavior
        RELOAD_FLAG=""
        if [ "${RELOAD_ENABLED:-1}" = "1" ]; then
            RELOAD_FLAG="--reload"
        fi
        
        # Run server using main.py (preferred method)
        v "server" python -m server.main --host 0.0.0.0 --port "${PORT:-8000}" $RELOAD_FLAG 2>&1 | tee /var/log/server_api.log &
        SERVER_PID=$!
        
        if [ $? -eq 0 ]; then
            log "INFO" "FastAPI server started on port ${PORT:-8000} with PID $SERVER_PID" "${GREEN}"
            echo "rest_api:running:$SERVER_PID" >> $SERVICE_STATUS_FILE
        else
            log "ERROR" "Failed to start FastAPI server using main.py" "${RED}"
            echo "rest_api:failed:0" >> $SERVICE_STATUS_FILE
        fi
    else
        log "WARNING" "main.py not found, trying to start app.py directly" "${YELLOW}"
        
        # Check if app.py exists in server directory
        if [ -f "/app/server/app.py" ]; then
            cd /app || { log "ERROR" "Failed to change directory to /app" "${RED}"; return 1; }
            
            # Use environment variable to control reload behavior
            RELOAD_FLAG=""
            if [ "${RELOAD_ENABLED:-1}" = "1" ]; then
                RELOAD_FLAG="--reload"
            fi
            
            # Run server using uvicorn directly with server.app:app
            v "server" python -m uvicorn server.app:app --host 0.0.0.0 --port "${PORT:-8000}" $RELOAD_FLAG 2>&1 | tee /var/log/server_api.log &
            SERVER_PID=$!
            
            if [ $? -eq 0 ]; then
                log "INFO" "FastAPI server started on port ${PORT:-8000} with PID $SERVER_PID" "${GREEN}"
                echo "rest_api:running:$SERVER_PID" >> $SERVICE_STATUS_FILE
            else
                log "ERROR" "Failed to start FastAPI server using app.py" "${RED}"
                echo "rest_api:failed:0" >> $SERVICE_STATUS_FILE
            fi
        else
            log "ERROR" "Neither main.py nor app.py found in /app/server directory" "${RED}"
            echo "rest_api:missing:0" >> $SERVICE_STATUS_FILE
            ls -la /app/server
        fi
    fi
}

# Start server if app.py or main.py exists
if [ -f /app/server/app.py ] || [ -f /app/server/main.py ]; then
    run_server
else
    log "WARNING" "Neither app.py nor main.py found in /app/server directory" "${YELLOW}"
    ls -la /app/server
    echo "rest_api:missing:0" >> $SERVICE_STATUS_FILE
fi

# Start gRPC server if grpc_server.py exists
if [ -f /app/server/grpc_server.py ]; then
    log "INFO" "Starting gRPC server..." "${BLUE}"
    # This check can be improved to see if the port is already in use
    v "server" python -m server.grpc_server --port "${GRPC_PORT:-50051}" --max_workers "${GRPC_MAX_WORKERS:-10}" &> /var/log/grpc_server.log &
    GRPC_PID=$!
    if [ $? -eq 0 ]; then
        log "INFO" "gRPC server started on port ${GRPC_PORT:-50051} with PID $GRPC_PID" "${GREEN}"
        echo "grpc_server:running:$GRPC_PID" >> $SERVICE_STATUS_FILE
        # Wait for the gRPC server to become available
        # Note: This wait_for_service uses HTTP check, which will fail for a gRPC service.
        # A proper gRPC health check would be needed for this.
        log "INFO" "Skipping gRPC health check as it requires a gRPC-specific client." "${YELLOW}"
    else
        log "ERROR" "Failed to start gRPC server" "${RED}"
        echo "grpc_server:failed:0" >> $SERVICE_STATUS_FILE
    fi
else
    log "WARNING" "grpc_server.py not found in /app/server directory" "${YELLOW}"
    echo "grpc_server:missing:0" >> $SERVICE_STATUS_FILE
fi

log "INFO" "-----------------------------------------------------------" "${GREEN}"
log "INFO" "All services started. Container is now running." "${GREEN}"
log "INFO" "Service logs are available in /var/log/" "${BLUE}"
log "INFO" "Use 'docker exec' to run commands in this container." "${BLUE}"
log "INFO" "Example: docker exec -it <container_id> /app/run_with_env.sh server python -m your_command" "${BLUE}"
log "INFO" "-----------------------------------------------------------" "${GREEN}"


# Monitor running services
monitor_services() {
    while true; do
        log "INFO" "Checking service status..." "${BLUE}"
        while IFS=: read -r service status pid; do
            if [ "$status" = "running" ] && [ "$pid" -ne "0" ]; then
                if ! ps -p "$pid" &> /dev/null; then
                    log "ERROR" "$service (PID $pid) has died" "${RED}"
                    # Here you could implement restart logic if needed
                    if [ "$pid" -eq "$SERVER_PID" ]; then
                        log "INFO" "Restarting $service..." "${BLUE}"
                        run_server
                    fi
                    if [ "$pid" -eq "$OLLAMA_PID" ]; then
                        log "INFO" "Restarting Ollama service..." "${BLUE}"
                        run_ollama
                    fi
                else
                    log "INFO" "$service (PID $pid) is running" "${GREEN}"
                fi
            fi
        done < "$SERVICE_STATUS_FILE"
        sleep 60  # Check every minute
    done
}

# Start the service monitoring in the background
monitor_services &
MONITOR_PID=$!

# Handle signals gracefully
cleanup() {
    log "INFO" "Shutting down services..." "${YELLOW}"
    # Kill all processes started by this script
    if [ -f "$SERVICE_STATUS_FILE" ]; then
        while IFS=: read -r service status pid; do
            if [ "$status" = "running" ] && [ "$pid" -ne 0 ]; then
                log "INFO" "Stopping $service (PID $pid)..." "${BLUE}"
                kill -TERM "$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
            fi
        done < "$SERVICE_STATUS_FILE"
    fi
    # Kill the monitoring process
    if [ -n "$MONITOR_PID" ]; then
        kill "$MONITOR_PID" 2>/dev/null
    fi
    # Kill any other background jobs of this script
    jobs -p | xargs kill 2>/dev/null
    log "INFO" "All services stopped" "${GREEN}"
    exit 0
}

trap cleanup INT TERM EXIT

# Keep container running
tail -f /dev/null